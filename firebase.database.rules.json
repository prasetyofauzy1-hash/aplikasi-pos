{
  "rules": {
    ".read": false,
    ".write": false,
    "posBackups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['archive', 'createdAt'])",
        "archive": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8388608"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
